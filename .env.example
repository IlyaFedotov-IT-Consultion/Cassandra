POSTGRES_DB=cassandra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

REDIS_PORT=6379
REDIS_HOST=localhost

API_PORT=3000
WEB_PORT=5173
JUDGE_PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cassandra
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
JUDGE_BASE_URL=http://localhost:8000
JUDGE_REQUEST_TIMEOUT_MS=560000
VITE_API_BASE_URL=http://localhost:3000
CASSANDRA_ADAPTER_MODE=live

PERPLEXITY_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me
OPENROUTER_JUDGE_MODEL=openai/gpt-5
OPENROUTER_CROSS_EXAMINER_MODEL=openai/gpt-5
OPENROUTER_SEARCH_MODEL=perplexity/sonar
# Set CASSANDRA_JUDGE_LLM=openrouter to enable real OpenRouter calls in the judge service.
# Any other value (or unset) keeps the deterministic FakeLLM backend used by tests.
CASSANDRA_JUDGE_LLM=fake

ZAI_API_KEY=replace-me
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=GLM5.1
ZAI_WEB_SEARCH_URL=https://api.z.ai/api/paas/v4/web_search
ZAI_WEB_SEARCH_PRIME_URL=https://api.z.ai/api/mcp/web_search_prime/mcp

POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

CUSTOM_MARKET_API_BASE_URL=https://example-market-provider.local
CUSTOM_MARKET_API_KEY=replace-me
