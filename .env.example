POSTGRES_DB=cassandra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

REDIS_PORT=6379
REDIS_HOST=localhost

API_PORT=3000
WEB_PORT=5173
JUDGE_PORT=8000
# The API listens on the loopback interface only. Set 0.0.0.0 to reach it from other machines,
# and set CASSANDRA_API_KEY when you do: in live mode any caller can start paid work.
API_HOST=127.0.0.1
# Browser origins allowed to call the API (comma-separated). Other origins get 403.
CASSANDRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional. When set, every API route except /health and /ready needs it as x-api-key (or a bearer token).
# The web app sends VITE_API_KEY; anyone who can load the web app can read that value.
# CASSANDRA_API_KEY=
# VITE_API_KEY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cassandra
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
JUDGE_BASE_URL=http://localhost:8000
JUDGE_REQUEST_TIMEOUT_MS=560000
VITE_API_BASE_URL=http://localhost:3000
CASSANDRA_ADAPTER_MODE=live
# Run watchlist discovery on each watchlist's cadence (hourly/daily/weekly). In live mode every run makes paid search calls.
CASSANDRA_DISCOVERY_SCHEDULE=on

PERPLEXITY_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me
# Judge ensemble: comma-separated model@reasoning-effort (see docs/research/2026-11-07-llm-forecasting-methods.md).
OPENROUTER_JUDGE_MODELS=openai/gpt-6.1-sol@high,anthropic/claude-opus-5.5@high,google/gemini-4-argon@high,deepseek/deepseek-v4.1-flash-1017@high
# Single-model fallback when OPENROUTER_JUDGE_MODELS is empty
OPENROUTER_JUDGE_MODEL=openai/gpt-6.1-sol
OPENROUTER_JUDGE_REASONING_EFFORT=high
OPENROUTER_CROSS_EXAMINER_MODEL=anthropic/claude-opus-5.5
OPENROUTER_CROSS_EXAMINER_REASONING_EFFORT=high
OPENROUTER_SEARCH_MODEL=perplexity/sonar-pro-search
# Cheap model for the relevance-rating and query-planning stages
OPENROUTER_UTILITY_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_UTILITY_REASONING_EFFORT=low
OPENROUTER_JUDGE_MAX_TOKENS=16000
OPENROUTER_CROSS_EXAMINER_MAX_TOKENS=4000
OPENROUTER_SEARCH_MAX_TOKENS=4000
# Live evidence search backend: auto (Z.AI when ZAI_API_KEY is set, else OpenRouter), zai, or openrouter
CASSANDRA_SEARCH_BACKEND=auto
OPENROUTER_WEB_SEARCH_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_WEB_SEARCH_ENGINE=perplexity
# Set CASSANDRA_JUDGE_LLM=openrouter to enable real OpenRouter calls in the judge service.
# Any other value (or unset) keeps the deterministic FakeLLM backend used by tests.
CASSANDRA_JUDGE_LLM=fake

ZAI_API_KEY=replace-me
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=GLM5.1
ZAI_WEB_SEARCH_URL=https://api.z.ai/api/paas/v4/web_search
ZAI_WEB_SEARCH_PRIME_URL=https://api.z.ai/api/mcp/web_search_prime/mcp

POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

CUSTOM_MARKET_API_BASE_URL=https://example-market-provider.local
CUSTOM_MARKET_API_KEY=replace-me
